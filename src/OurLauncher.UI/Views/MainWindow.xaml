<Window x:Class="OurLauncher.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OurLauncher" Height="560" Width="900"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#17191F" Foreground="#F2F3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24,18" Background="#20232B">
            <DockPanel>
                <TextBlock Text="OurLauncher" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="PORTABLE" DockPanel.Dock="Right" Foreground="#A8ADBA" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <TextBlock Text="Добро пожаловать в OurLauncher" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Здесь появятся выбор версии Minecraft, аккаунты и настройки запуска."
                       Margin="0,14,0,24" Foreground="#B8BDCA" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Скоро здесь будет запуск Minecraft" Height="44" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
